{
  "name": "vscode-dev-tools",
  "displayName": "Dev Tools",
  "description": "Convert the active Markdown file to JIRA-compatible format and copy to clipboard.",
  "version": "1.2.1",
  "publisher": "vincentlo",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincentlo/vscode-md-to-jira"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dev-tools.exportCloud",
        "title": "Dev Tools: Export MD to JIRA (Cloud)"
      },
      {
        "command": "dev-tools.exportServer",
        "title": "Dev Tools: Export MD to JIRA (Server)"
      },
      {
        "command": "dev-tools.gitReleaseAl",
        "title": "Dev Tools: Git Release (Zip)"
      },
      {
        "command": "dev-tools.gitCommitUrl",
        "title": "Dev Tools: Git Commit Url (Copy)"
      },
      {
        "command": "dev-tools.gitCommitMessageAi",
        "title": "Dev Tools: Git Commit Message (AI)"
      },
      {
        "command": "dev-tools.jsonParse",
        "title": "Dev Tools: JSON - Parse"
      },
      {
        "command": "dev-tools.jsonMinify",
        "title": "Dev Tools: JSON - Minify"
      },
      {
        "command": "dev-tools.jsonStringify",
        "title": "Dev Tools: JSON - Stringify"
      },
      {
        "command": "dev-tools.jiraActivity",
        "title": "Dev Tools: JIRA Activity"
      }
    ],
    "configuration": {
      "title": "Dev Tools",
      "properties": {
        "dev-tools.gitCommitUrlCount": {
          "type": "number",
          "default": 50,
          "description": "Number of commits to show in the Git Commit Url picker"
        },
        "dev-tools.jiraActivityUser": {
          "type": "string",
          "default": "",
          "description": "Jira username for JIRA Activity command (-u)."
        },
        "dev-tools.jiraActivityMaxResults": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of activity entries to retrieve for JIRA Activity (-n)."
        },
        "dev-tools.jiraActivityPassword": {
          "type": "string",
          "default": "",
          "description": "Jira password for JIRA Activity command (-p). (Sensitive)",
          "markdownDescription": "Jira password for JIRA Activity command (-p). **Sensitive**."
        },
        "dev-tools.jiraActivityBaseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL for Jira server (e.g., http://jira.example.com:8080). Required."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "vscode:prepublish": "node esbuild.js --production",
    "test": "vitest run"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "axios": "^1.16.1",
    "marked": "^14.0.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
